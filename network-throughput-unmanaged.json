{
  "apiVersion": "dashboard.grafana.app/v0alpha1",
  "kind": "LibraryPanel",
  "metadata": {
    "name": "unmanaged-network-throughput"
  },
  "spec": {
    "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
    },
    "description": "Unmanaged panel created via API for migrate testing.",
    "fieldConfig": {
      "defaults": {
        "custom": {
          "drawStyle": "line",
          "fillOpacity": 10
        },
        "unit": "bps"
      },
      "overrides": []
    },
    "gridPos": {
      "h": 8,
      "w": 12,
      "x": 0,
      "y": 0
    },
    "options": {
      "legend": {
        "displayMode": "list",
        "placement": "bottom"
      },
      "tooltip": {
        "mode": "single"
      }
    },
    "pluginVersion": "11.0.0",
    "targets": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "expr": "rate(node_network_receive_bytes_total[5m])",
        "legendFormat": "{{instance}}",
        "refId": "A"
      }
    ],
    "title": "Network Throughput (unmanaged)",
    "type": "timeseries"
  }
}