{
  "apiVersion": "dashboard.grafana.app/v0alpha1",
  "kind": "LibraryPanel",
  "metadata": {
    "name": "lib-request-rate",
    "labels": {
      "team": "app",
      "category": "golden-signals"
    }
  },
  "spec": {
    "type": "timeseries",
    "pluginVersion": "11.0.0",
    "title": "Request Rate",
    "description": "Reusable RED-method request rate panel (requests/sec by route).",
    "options": {
      "legend": {
        "displayMode": "table",
        "placement": "bottom",
        "calcs": [
          "mean",
          "lastNotNull"
        ]
      },
      "tooltip": {
        "mode": "multi"
      }
    },
    "fieldConfig": {
      "defaults": {
        "unit": "reqps",
        "min": 0,
        "custom": {
          "drawStyle": "line",
          "fillOpacity": 15
        }
      },
      "overrides": []
    },
    "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
    },
    "targets": [
      {
        "refId": "A",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "expr": "sum by (route) (rate(http_requests_total[5m]))",
        "legendFormat": "{{route}}"
      }
    ]
  }
}
