{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "executive-summary"
  },
  "spec": {
    "title": "Executive Summary",
    "description": "Single-pane business overview. The headline revenue tile is a shared library panel.",
    "tags": [
      "business",
      "kpi",
      "executive"
    ],
    "editable": true,
    "preload": true,
    "liveNow": false,
    "cursorSync": "Off",
    "links": [],
    "annotations": [],
    "timeSettings": {
      "from": "now-7d",
      "to": "now",
      "autoRefresh": "5m",
      "autoRefreshIntervals": [
        "5m",
        "15m",
        "30m",
        "1h"
      ],
      "timezone": "browser",
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "datasource",
          "pluginId": "prometheus",
          "refresh": "never",
          "regex": "",
          "current": {
            "text": "Prometheus",
            "value": "prometheus"
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "label": "Data source",
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": true
        }
      }
    ],
    "elements": {
      "revenue": {
        "kind": "LibraryPanel",
        "spec": {
          "id": 1,
          "title": "Revenue (Today)",
          "libraryPanel": {
            "uid": "lib-revenue-kpi",
            "name": "Revenue (Today)"
          }
        }
      },
      "signups": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "New Signups",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum(increase(user_signups_total[1d]))",
                        "legendFormat": "signups"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "11.0.0",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "area",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ]
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "decimals": 0
                },
                "overrides": []
              }
            }
          }
        }
      },
      "revenue-trend": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Revenue Trend (7d)",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum(increase(orders_revenue_usd_total[1h]))",
                        "legendFormat": "hourly revenue"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "11.0.0",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "currencyUSD",
                  "min": 0
                },
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "GridLayout",
      "spec": {
        "items": [
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 8,
              "element": {
                "kind": "ElementReference",
                "name": "revenue"
              }
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 12,
              "y": 0,
              "width": 12,
              "height": 8,
              "element": {
                "kind": "ElementReference",
                "name": "signups"
              }
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 0,
              "y": 8,
              "width": 24,
              "height": 9,
              "element": {
                "kind": "ElementReference",
                "name": "revenue-trend"
              }
            }
          }
        ]
      }
    }
  }
}
