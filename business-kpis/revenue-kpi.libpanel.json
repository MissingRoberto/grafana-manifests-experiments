{
  "apiVersion": "dashboard.grafana.app/v0alpha1",
  "kind": "LibraryPanel",
  "metadata": {
    "name": "lib-revenue-kpi",
    "labels": {
      "team": "business",
      "category": "kpi"
    }
  },
  "spec": {
    "type": "stat",
    "pluginVersion": "11.0.0",
    "title": "Revenue (Today)",
    "description": "Reusable big-number KPI panel for today's revenue. Reused across exec and finance dashboards.",
    "options": {
      "colorMode": "value",
      "graphMode": "area",
      "textMode": "value_and_name",
      "reduceOptions": {
        "calcs": [
          "lastNotNull"
        ]
      }
    },
    "fieldConfig": {
      "defaults": {
        "unit": "currencyUSD",
        "decimals": 0,
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "color": "red",
              "value": null
            },
            {
              "color": "yellow",
              "value": 50000
            },
            {
              "color": "green",
              "value": 100000
            }
          ]
        }
      },
      "overrides": []
    },
    "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
    },
    "targets": [
      {
        "refId": "A",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "expr": "sum(increase(orders_revenue_usd_total[24h]))",
        "legendFormat": "revenue"
      }
    ]
  }
}
