{
  "apiVersion": "dashboard.grafana.app/v0alpha1",
  "kind": "LibraryPanel",
  "metadata": {
    "name": "lib-cpu-usage",
    "labels": {
      "team": "platform",
      "category": "infrastructure"
    }
  },
  "spec": {
    "type": "timeseries",
    "pluginVersion": "11.0.0",
    "title": "CPU Usage",
    "description": "Reusable CPU utilization panel. Shared across all platform dashboards.",
    "options": {
      "legend": {
        "displayMode": "table",
        "placement": "right",
        "calcs": [
          "mean",
          "max"
        ]
      },
      "tooltip": {
        "mode": "multi"
      }
    },
    "fieldConfig": {
      "defaults": {
        "unit": "percent",
        "min": 0,
        "max": 100,
        "custom": {
          "drawStyle": "line",
          "fillOpacity": 20,
          "stacking": {
            "mode": "normal",
            "group": "A"
          }
        }
      },
      "overrides": []
    },
    "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
    },
    "targets": [
      {
        "refId": "A",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
        "legendFormat": "{{instance}}"
      }
    ]
  }
}
