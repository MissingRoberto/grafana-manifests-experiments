{
  "apiVersion": "dashboard.grafana.app/v0alpha1",
  "kind": "LibraryPanel",
  "metadata": {
    "name": "lib-cpu-usage",
    "labels": {
      "team": "platform",
      "category": "infrastructure"
    }
  },
  "spec": {
    "title": "CPU Usage",
    "description": "Reusable CPU utilization panel broken down by mode. Shared across all platform dashboards.",
    "type": "timeseries",
    "schemaVersion": 39,
    "version": 1,
    "model": {
      "type": "timeseries",
      "title": "CPU Usage",
      "description": "CPU utilization by mode",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  }
}
