{
  "apiVersion": "dashboard.grafana.app/v0alpha1",
  "kind": "LibraryPanel",
  "metadata": {
    "name": "lib-memory-usage",
    "labels": {
      "team": "platform",
      "category": "infrastructure"
    }
  },
  "spec": {
    "title": "Memory Usage",
    "description": "Reusable memory utilization panel. Shared across all platform dashboards.",
    "type": "timeseries",
    "schemaVersion": 39,
    "version": 1,
    "model": {
      "type": "timeseries",
      "title": "Memory Usage",
      "description": "Used vs available memory",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["last", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "{{instance}} used"
        }
      ]
    }
  }
}
