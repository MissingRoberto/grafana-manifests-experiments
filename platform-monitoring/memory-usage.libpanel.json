{
  "apiVersion": "dashboard.grafana.app/v0alpha1",
  "kind": "LibraryPanel",
  "metadata": {
    "name": "lib-memory-usage",
    "labels": {
      "team": "platform",
      "category": "infrastructure"
    }
  },
  "spec": {
    "type": "timeseries",
    "pluginVersion": "11.0.0",
    "title": "Memory Usage",
    "description": "Reusable memory utilization panel. Shared across all platform dashboards.",
    "options": {
      "legend": {
        "displayMode": "table",
        "placement": "right",
        "calcs": [
          "last",
          "max"
        ]
      },
      "tooltip": {
        "mode": "multi"
      }
    },
    "fieldConfig": {
      "defaults": {
        "unit": "bytes",
        "min": 0,
        "custom": {
          "drawStyle": "line",
          "fillOpacity": 25
        }
      },
      "overrides": []
    },
    "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
    },
    "targets": [
      {
        "refId": "A",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
        "legendFormat": "{{instance}} used"
      }
    ]
  }
}
