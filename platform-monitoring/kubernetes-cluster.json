{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "kubernetes-cluster"
  },
  "spec": {
    "title": "Kubernetes Cluster",
    "description": "Cluster-wide resource view. Reuses the shared CPU/Memory library panels.",
    "tags": [
      "kubernetes",
      "platform"
    ],
    "editable": true,
    "preload": false,
    "liveNow": false,
    "cursorSync": "Crosshair",
    "links": [],
    "annotations": [],
    "timeSettings": {
      "from": "now-3h",
      "to": "now",
      "autoRefresh": "1m",
      "autoRefreshIntervals": [
        "30s",
        "1m",
        "5m",
        "15m"
      ],
      "timezone": "browser",
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "datasource",
          "pluginId": "prometheus",
          "refresh": "never",
          "regex": "",
          "current": {
            "text": "Prometheus",
            "value": "prometheus"
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "label": "Data source",
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": true
        }
      }
    ],
    "elements": {
      "cpu": {
        "kind": "LibraryPanel",
        "spec": {
          "id": 1,
          "title": "CPU Usage",
          "libraryPanel": {
            "uid": "lib-cpu-usage",
            "name": "CPU Usage"
          }
        }
      },
      "memory": {
        "kind": "LibraryPanel",
        "spec": {
          "id": 2,
          "title": "Memory Usage",
          "libraryPanel": {
            "uid": "lib-memory-usage",
            "name": "Memory Usage"
          }
        }
      },
      "pods": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Running Pods by Namespace",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum by (namespace) (kube_pod_status_phase{phase=\"Running\"})",
                        "legendFormat": "{{namespace}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "barchart",
            "version": "11.0.0",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0
                },
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "GridLayout",
      "spec": {
        "items": [
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 8,
              "element": {
                "kind": "ElementReference",
                "name": "cpu"
              }
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 12,
              "y": 0,
              "width": 12,
              "height": 8,
              "element": {
                "kind": "ElementReference",
                "name": "memory"
              }
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 0,
              "y": 8,
              "width": 24,
              "height": 9,
              "element": {
                "kind": "ElementReference",
                "name": "pods"
              }
            }
          }
        ]
      }
    }
  }
}
